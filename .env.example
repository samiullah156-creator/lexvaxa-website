NEXT_PUBLIC_SITE_URL=https://lexvaxa.com
# Set true for non-production deployments outside Vercel previews.
SITE_NOINDEX=false

# Admin backend (../lexvaxa-backend). Leave all three empty to run the site on its own:
# the contact form then prepares an email draft and only the built-in guides are listed.
# CMS_URL is read on the server; NEXT_PUBLIC_CMS_URL is the address the visitor's browser
# sends the contact form to. They are normally the same.
CMS_URL=
NEXT_PUBLIC_CMS_URL=
# Shared with the backend so publishing refreshes pages immediately. Any long random text.
REVALIDATE_SECRET=
# Optional: Search Console and Bing Webmaster HTML-tag verification codes (content value only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
